  m_TableData:
  - m_Id: 4197576707366912
    m_Localized: Caption above the party's combined health and combat strength, on
      the combat screen's side panel.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577269403648
    m_Localized: Header over the bar showing which side is winning, between the two
      party cards.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577286180864
    m_Localized: Reading under the advantage bar when both sides have been wiped
      out.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577290375168
    m_Localized: Reading under the advantage bar when neither side is meaningfully
      ahead.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577290375169
    m_Localized: Reading under the advantage bar. {Side} is the winning party's name,
      e.g. Guards or Bandits.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577290375170
    m_Localized: Reading under the advantage bar, one band stronger than SlightlyAhead.
      {Side} is the winning party's name.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577290375171
    m_Localized: Reading under the advantage bar, the strongest band. {Side} is the
      winning party's name.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577537839104
    m_Localized: Small line above the outcome title. {_int_Round} is how many rounds
      the battle lasted.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033408
    m_Localized: Header on the outcome tile counting the player's own casualties.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033409
    m_Localized: Header on the outcome tile counting the bandits' casualties.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033410
    m_Localized: Outcome card headline when the player's guards win the battle.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033411
    m_Localized: Outcome card headline when the player's guards are wiped out.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033412
    m_Localized: Outcome card headline when both sides are wiped out in the same
      round.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033413
    m_Localized: One-line consequence under the Victory headline on the outcome card.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033414
    m_Localized: One-line consequence under the Defeat headline on the outcome card.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577542033415
    m_Localized: One-line consequence under the Draw headline on the outcome card.
    m_Metadata:
      m_Items: []
  - m_Id: 4197577802080256
    m_Localized: Suffix under a casualty count on the outcome card, e.g. 3 over "of
      10". {_int_MaxUnitCount} is how many units that side started with.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
