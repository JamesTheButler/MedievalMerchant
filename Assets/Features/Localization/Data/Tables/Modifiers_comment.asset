      - rid: 7663118221313572959
  - m_Id: 1036279308310
    m_Localized: 'Example:

      "Non-Forest towns only request Ocean goods in their
      missions."'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572959
  - m_Id: 11241070487625728
    m_Localized: A set of modifiers tied to each level, for example all the effects
      around ocean good in lvl 2.
    m_Metadata:
      m_Items: []
  - m_Id: 366830397906944
    m_Localized: '{0} is the event name. Example:

      "Event started: Heavy Rain"'
    m_Metadata:
      m_Items: []
  - m_Id: 366897418690560
    m_Localized: '{0} is the event name. Example:

      "Event expired: Heavy Rain"'
    m_Metadata:
      m_Items: []
  - m_Id: 11241954563022848
    m_Localized: '{0} is the amount of ongoing events. Example:

      "Ongoing Events
      (3)"'
    m_Metadata:
      m_Items: []
