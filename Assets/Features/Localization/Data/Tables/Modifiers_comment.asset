  m_TableData:
  - m_Id: 357294081531904
    m_Localized: Header for the ongoing events panel in the top-right menu with the
      game controller icon.
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308313
    m_Localized: 'Example:

      "+15% development change rate"'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572959
  - m_Id: 1036279308314
    m_Localized: 'Example:

      "+15% caravan movement speed"'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572959
  - m_Id: 1036279308315
    m_Localized: '{GoodSelector} is a complex one. It will be filled in to describe
      which goods the effect applies to.

      Example"

      "+15% to prices for
      Tier II goods from the Ocean"'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572959
  - m_Id: 1036279308316
    m_Localized: 
    m_Metadata:
      m_Items:
      - rid: 7663118221313572959
