  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 6deeca01110b62f428f9ebb535eb63e7, type: 2}
  m_Metadata:
    m_Items:
    - rid: 1854277321561473026
  m_TableData:
  - m_Id: 518081437696
    m_Localized: Anleitung
    m_Metadata:
      m_Items: []
  - m_Id: 518102409216
    m_Localized: 'Anleitung: {TutorialName}'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518102409217
    m_Localized: Reise nach {TownName}
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518102409218
    m_Localized: Baue {ProducerName} in {TownName}
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518102409219
    m_Localized: 'Spiel fortsetzen [Leertaste]'
    m_Metadata:
      m_Items: []
  - m_Id: 518102409220
    m_Localized: 'Spielgeschwindigkeit auf schnell setzen [2]'
    m_Metadata:
      m_Items: []
  - m_Id: 518102409221
    m_Localized: Werte deinen Karren auf Stufe {Tier} auf.
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518102409222
    m_Localized: Kaufe {_int_Amount} {GoodName} in {TownName}.
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603520
    m_Localized: Verkaufe {_int_Amount} {GoodName} in {TownName}.
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603521
    m_Localized: Werte {TownName} auf Stufe {Tier} auf.
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603522
    m_Localized: "Willkommen, H\xE4ndler! Dies ist ein Spiel \xFCber den Handel.\n\nDu
      wirst kleinen, abgeschiedenen St\xE4dten helfen, sich zu entwickeln, indem
      du ihnen lieferst, was sie brauchen...\n\nUnd dabei wirst du so manchen h\xFCbschen
      Taler verdienen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603523
    m_Localized: "In dieser Einf\xFChrung wirst du {TownA} und {TownB} auf Stufe
      II entwickeln.\n\nSt\xE4dte wachsen, indem sie die Waren verbrauchen, die du
      ihnen verkaufst, durch Handelsauftr\xE4ge und auf verschiedene andere Weisen."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603524
    m_Localized: "Es sieht so aus, als h\xE4tte {TownB} gerade einen aktiven Handelsauftrag
      f\xFCr Heu. Du bist gerade in  {TownA} , wo Heu produziert wird. Kaufe 15 Heu,
      reise nach  {TownB}  und verkaufe es dort."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603525
    m_Localized: "Gut gemacht! Das Erf\xFCllen von Auftr\xE4gen bringt dir eine Belohnung
      und steigert die Entwicklung der Stadt. Du kannst die Entwicklung einer Stadt
      oben im Stadtfenster einsehen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603526
    m_Localized: "In der Zwischenzeit ist {TownA} bereit f\xFCr ein Upgrade. Um St\xE4dte
      auf die n\xE4chste Stufe aufzuwerten, musst du ihre Upgradeauftr\xE4ge erf\xFCllen."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603527
    m_Localized: "{TownA} braucht Beeren f\xFCr das Upgrade. Der Wald bei {TownB}
      hat Beeren. Baue einen Beerensammler in TownB und kaufe 30 Beeren."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603528
    m_Localized: "Sehr gut! In Produktionsgeb\xE4ude zu investieren produziert nicht
      nur Waren in der Stadt, sondern steigert auch die Entwicklung und dein Ansehen
      bei ihnen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603529
    m_Localized: "Es wird eine Weile dauern, die 30 Beeren f\xFCr den Upgradeauftrag
      von {TownA} zu sammeln. Du kannst hier warten und einige Tage verstreichen
      lassen, indem du das Spiel mit [Leertaste] fortsetzt. Um die Zeit weiter zu
      beschleunigen, dr\xFCcke [2]."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603530
    m_Localized: "Es gibt nun genug Beeren. Liefere sie an {TownA}, um das Upgrade
      abzuschlie\xDFen. Kaufe bei der Gelegenheit auch etwas Wildfleisch. Je mehr
      Waren eine Stadt gekauft hat, desto schneller entwickelt sie sich. Und desto
      besser deine Margen!"
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603531
    m_Localized: Um mehr als eine Ware in deine Karawane zu laden, musst du zuerst
      deinen Karren aufwerten. Aufgewertete Karren sind schneller und bieten mehr
      Lagerplatz. Aber achte auf die steigenden Unterhaltskosten!
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603532
    m_Localized: "Gut gemacht! {TownA} wurde auf Stufe II aufgewertet. Die Produktionsgeschwindigkeit
      ist gestiegen und die Stadt verdient mehr Taler, was gro\xDFartig f\xFCr
      dich ist, da sie dir mehr Waren auf einmal abkaufen kann. Das Aufwerten einer
      Stadt schaltet auch die n\xE4chste Warenstufe frei, die viel bessere Gewinnchancen
      bietet."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603533
    m_Localized: "Es ist Zeit, dein eigenes Gl\xFCck zu finden. Mit allem, was du
      gelernt hast, hilf nun {TownB}, Stufe II zu erreichen."
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603534
    m_Localized: "{TownA} hat einige ungenutzte Ressourcen in den umliegenden Feldern.
      Baue weitere Produktionsgeb\xE4ude, transportiere Waren hin und her und hilf
      {TownB} zu gedeihen.\n\nViel Gl\xFCck da drau\xDFen!"
    m_Metadata:
      m_Items:
      - rid: 1854277321561473026
  - m_Id: 518106603535
    m_Localized: "Einf\xFChrung"
    m_Metadata:
      m_Items: []
  - m_Id: 518106603536
    m_Localized: Willkommen!
    m_Metadata:
      m_Items: []
  - m_Id: 518106603537
    m_Localized: "Danke, dass du Medieval Merchant spielst!\n\nDein Ziel ist es,
      ein profitables Handelsnetzwerk aufzubauen, indem du Waren zwischen St\xE4dten
      kaufst und verkaufst und ihnen hilfst, im Laufe der Zeit zu wachsen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603538
    m_Localized: Handel
    m_Metadata:
      m_Items: []
  - m_Id: 518106603539
    m_Localized: "Du kannst Waren kaufen, die St\xE4dte produzieren, und sie an andere
      St\xE4dte verkaufen. Dein Inventar findest du links und das Inventar sowie
      die Produktionsgeb\xE4ude der Stadt rechts auf dem Bildschirm."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603540
    m_Localized: Preise
    m_Metadata:
      m_Items: []
  - m_Id: 518106603541
    m_Localized: "Preise werden durch Angebot und Nachfrage sowie eine Vielzahl anderer
      Faktoren bestimmt. Achte auf aktuelle Ereignisse im Spiel.\n\nWenn du verstehen
      m\xF6chtest, wie Preise berechnet werden, kannst du im Handelsfenster mit der
      Maus dar\xFCber fahren."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603542
    m_Localized: "St\xE4dte"
    m_Metadata:
      m_Items: []
  - m_Id: 518106603543
    m_Localized: "Jede Stadt produziert bestimmte Waren basierend auf den Ressourcen
      der umliegenden Regionen. St\xE4dte mit dem zu versorgen, was ihnen fehlt,
      hilft ihnen zu wachsen, bessere Produktionsgeb\xE4ude freizuschalten und neue
      Handelsm\xF6glichkeiten zu er\xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603544
    m_Localized: Karawane
    m_Metadata:
      m_Items: []
  - m_Id: 518106603545
    m_Localized: "Karren bestimmen, wie viel du transportieren kannst und wie schnell
      du reist. Je besser deine Karren, desto mehr kannst du transportieren, aber
      desto h\xF6her sind auch deine Unterhaltskosten."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603546
    m_Localized: Sieg und Niederlage
    m_Metadata:
      m_Items: []
  - m_Id: 518106603547
    m_Localized: "Um zu gewinnen, musst du alle Siegbedingungen erf\xFCllen und darfst
      keine Niederlagebedingung ausl\xF6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603550
    m_Localized: "Viel Gl\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 518106603551
    m_Localized: "Das war's erstmal :)\n\nDu wirst im Laufe des Spiels noch mehr
      lernen. Genie\xDFe die Reise!"
    m_Metadata:
      m_Items: []
  - m_Id: 518106603552
    m_Localized: Steuerung & die Weltkarte
    m_Metadata:
      m_Items: []
  - m_Id: 518106603553
    m_Localized: Kamerabewegung
    m_Metadata:
      m_Items: []
  - m_Id: 518106603554
    m_Localized: "Bewege die Kamera mit WASD. Halte die mittlere Maustaste gedr\xFCckt,
      um die Ansicht zu verschieben.\n\n[C] zentriert die Kamera auf deinen Standort.\n\n[Leertaste]
      pausiert das Spiel. [1] und [2] stellen die Spielgeschwindigkeit ein."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603555
    m_Localized: "Reisen zu St\xE4dten"
    m_Metadata:
      m_Items: []
  - m_Id: 518106603556
    m_Localized: Klicke mit der rechten Maustaste auf eine Stadt, um deine Karawane
      dorthin zu bewegen. Reisen kostet Zeit und Unterhalt.
    m_Metadata:
      m_Items: []
  - m_Id: 518106603557
    m_Localized: Stadtdetails
    m_Metadata:
      m_Items: []
  - m_Id: 518106603558
    m_Localized: "Klicke mit der linken Maustaste auf St\xE4dte und Produktionszonen,
      um ihre Details einzusehen."
    m_Metadata:
      m_Items: []
  - m_Id: 518106603559
    m_Localized: "St\xE4dte"
    m_Metadata:
      m_Items: []
  - m_Id: 518110797824
    m_Localized: Allgemein
    m_Metadata:
      m_Items: []
  - m_Id: 518110797825
    m_Localized: "St\xE4dte sind dein Weg zum Sieg. Du wirst mit ihnen handeln, sie
      auf deine Seite bringen, ihre Auftr\xE4ge erf\xFCllen und ihnen helfen, sich
      zu entwickeln und zu gedeihen."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797832
    m_Localized: Ansehen
    m_Metadata:
      m_Items: []
  - m_Id: 518110797833
    m_Localized: "St\xE4dte merken sich, wie du sie behandelst. Ihre Meinung \xFCber
      dich \xE4ndert sich mit jedem Handel und je nachdem, ob du ihnen bei der Entwicklung
      hilfst oder sie vernachl\xE4ssigst.\n\nHandelsgesch\xE4fte, der Bau von Geb\xE4uden,
      das Scheitern oder Abschlie\xDFen von Auftr\xE4gen und anderes beeinflussen
      dein Ansehen bei den St\xE4dten."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797838
    m_Localized: Stadtentwicklung
    m_Metadata:
      m_Items: []
  - m_Id: 518110797839
    m_Localized: Entwicklung
    m_Metadata:
      m_Items: []
  - m_Id: 518110797840
    m_Localized: "Jede Stadt hat einen Entwicklungsbalken, der ihr Wachstum im Laufe
      der Zeit widerspiegelt. Die Lieferung fremder Waren, das Abschlie\xDFen von
      Auftr\xE4gen und die Finanzierung von Produktionsgeb\xE4uden steigern den Entwicklungstrend
      der Stadt.\n\nMit wachsender Entwicklung werden immer mehr Meilensteine freigeschaltet,
      die die Werte der Stadt verbessern und weitere Handelsm\xF6glichkeiten er\xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797841
    m_Localized: "Auftr\xE4ge"
    m_Metadata:
      m_Items: []
  - m_Id: 518110797842
    m_Localized: "St\xE4dte starten gelegentlich Handelsauftr\xE4ge, in denen sie
      bestimmte Waren anfordern.\n\nDiese Anforderungen zu erf\xFCllen f\xF6rdert
      ihre Entwicklung. Wenn du die angeforderten Waren nicht rechtzeitig lieferst,
      wird die Stadt jedoch zur\xFCckgeworfen.\n\nW\xE4hle weise, wem du hilfst und
      wen du ignorierst, denn du wirst wahrscheinlich nicht genug Zeit haben, um
      alle zufriedenzustellen."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797843
    m_Localized: Stadtstufen
    m_Metadata:
      m_Items: []
  - m_Id: 518110797844
    m_Localized: "Um einer Stadt beim Aufstieg in die n\xE4chste Stufe zu helfen,
      musst du ihre Upgradeauftr\xE4ge erf\xFCllen. Diese werden verf\xFCgbar, sobald
      die Stadt eine Entwicklung von 100 erreicht.\n\nSt\xE4dte h\xF6herer Stufen
      k\xF6nnen h\xF6herwertige Waren produzieren, die bessere Margen f\xFCr dich
      bieten."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797845
    m_Localized: Stadtproduktion
    m_Metadata:
      m_Items: []
  - m_Id: 518110797846
    m_Localized: "Produktionsgeb\xE4ude"
    m_Metadata:
      m_Items: []
  - m_Id: 518110797847
    m_Localized: "Du kannst Produktionsgeb\xE4ude in St\xE4dten finanzieren, damit
      sie Waren produzieren und die Entwicklung steigern.\n\nDen Bau von Produktionsst\xE4tten
      zu finanzieren ist essenziell, da sie deinem Handelsnetzwerk mehr Ressourcen
      hinzuf\xFCgen und es dir erm\xF6glichen, Auftr\xE4ge zu erf\xFCllen, auf Weltereignisse
      zu reagieren und Gewinne zu erzielen, indem du die richtigen Waren zur richtigen
      Zeit lieferst."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797848
    m_Localized: Produktionsstufen
    m_Metadata:
      m_Items: []
  - m_Id: 518110797849
    m_Localized: "Stufe-I-Geb\xE4ude k\xF6nnen basierend auf den umliegenden Regionen
      der Stadt gebaut werden.\n\nStufe-II-Geb\xE4ude werden auf Stufe-I-Geb\xE4ude
      aufgebaut.\n\nStufe-III-Geb\xE4ude werden auf ein Stufe-II-Geb\xE4ude aufgebaut
      und ben\xF6tigen eine zweite Stufe-II-Ware, um Stufe-III-Waren herzustellen.
      Diese zweite Ware kann entweder in der Stadt produziert oder von dir geliefert
      (verkauft) werden."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797850
    m_Localized: Karawane
    m_Metadata:
      m_Items: []
  - m_Id: 518110797851
    m_Localized: Karren & Aufwertungen
    m_Metadata:
      m_Items: []
  - m_Id: 518110797852
    m_Localized: "Wenn du mehr Taler verdienst und dein Handelsnetzwerk ausbaust,
      wirst du schneller reisen und mehr Waren transportieren wollen.\n\nDaf\xFCr
      kannst du deine Karren aufwerten oder neue kaufen. Aber Vorsicht! Eine gr\xF6\xDFere
      Karawane erfordert auch mehr Unterhalt."
    m_Metadata:
      m_Items: []
  - m_Id: 518110797853
    m_Localized: Gefolge
    m_Metadata:
      m_Items: []
  - m_Id: 518110797854
    m_Localized: "Gef\xE4hrten"
    m_Metadata:
      m_Items: []
  - m_Id: 518110797855
    m_Localized: "Du kannst Gef\xE4hrten f\xFCr dein Gefolge anwerben. Jeder Gef\xE4hrte
      bietet einzigartige Boni, die deine F\xE4higkeit zu handeln, zu reisen und
      auf verschiedene Weisen voranzukommen beeinflussen.\n\nFahre mit der Maus \xFCber
      die verschiedenen Aufwertungen, um ihre Effekte zu sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 3398595611549696
    m_Localized: Weiter >
    m_Metadata:
      m_Items: []
  - m_Id: 11229775562498048
    m_Localized: Aufgaben
    m_Metadata:
      m_Items: []
