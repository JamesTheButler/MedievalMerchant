  m_TableData:
  - m_Id: 31624117837824
    m_Localized: Niveau {_int_LevelIndex:D2}
    m_Metadata:
      m_Items:
      - rid: 1854277275464761471
  - m_Id: 169715130368
    m_Localized: "Parfois, il est difficile de prendre un nouveau d\xE9part. Pas
      ici. Tout est plus simple dans ce niveau. Parfait pour faire ses premi\xE8res
      armes !"
    m_Metadata:
      m_Items: []
  - m_Id: 117475074048
    m_Localized: "Des d\xE9buts simples"
    m_Metadata:
      m_Items: []
  - m_Id: 23031704412160
    m_Localized: "Les oc\xE9ans sont riches par ici. Et tout le monde en veut une
      part."
    m_Metadata:
      m_Items: []
  - m_Id: 23033407299584
    m_Localized: "P\xEAche aux bonnes affaires \n"
    m_Metadata:
      m_Items: []
  - m_Id: 23593455935488
    m_Localized: Amis et ennemis
    m_Metadata:
      m_Items: []
  - m_Id: 23694530273280
    m_Localized: "La vie d'un marchant tourne autour des relations. Choisissez vos
      alli\xE9s avec prudence car votre d\xE9cision ne sera pas sans cons\xE9quences."
    m_Metadata:
      m_Items: []
  - m_Id: 2641516104212480
    m_Localized: "Choisissez vos alli\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 2641516116795392
    m_Localized: "Choisissez une r\xE9gion alli\xE9e et gagnez leur faveur. \r\nChoisissez
      prudemment, votre r\xE9putation dans les autres r\xE9gions en d\xE9pend."
    m_Metadata:
      m_Items: []
  - m_Id: 23759730728960
    m_Localized: Gangsta's Paradise
    m_Metadata:
      m_Items: []
  - m_Id: 23762297643008
    m_Localized: "Des bandits rodent dans la r\xE9gion et les villes sont en ruines.
      Vous feriez mieux d'enfiler votre meilleure armure."
    m_Metadata:
      m_Items: []
  - m_Id: 23805503168512
    m_Localized: Des adieux difficiles
    m_Metadata:
      m_Items: []
  - m_Id: 23857697087488
    m_Localized: "Parfois, dire au revoir est difficile. Ici, c'est litt\xE9ralement
      le cas. Accrochez-vous et profitez du dernier niveau."
    m_Metadata:
      m_Items: []
  - m_Id: 24112274563072
    m_Localized: Introduction
    m_Metadata:
      m_Items: []
  - m_Id: 24145132740608
    m_Localized: "Bienvenue dans le jeu ! Ce niveau vous apprendra les bases du commerce
      et du d\xE9veloppement des villes."
    m_Metadata:
      m_Items: []
  - m_Id: 3281913608364032
    m_Localized: "Meilleur temps : jour {_int_Day} de l'ann\xE9e {_int_Year}"
    m_Metadata:
      m_Items:
      - rid: 1854277275464761471
