      m_Items: []
  - m_Id: 1012350803990
    m_Localized: Du hast ein(e) {ProducerName} errichtet.
    m_Metadata:
      m_Items:
      - rid: 3853118801594024018
  - m_Id: 1012350803991
    m_Localized: "Die Siedlung wurde mehr als {_int_DayCount} Tage vernachl\xE4ssigt."
