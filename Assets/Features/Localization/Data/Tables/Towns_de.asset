    m_Metadata:
      m_Items:
      - rid: 3853118801594024018
  - m_Id: 1012350803982
    m_Localized: Grundverfall einer Stufe-{TierRoman}-Siedlung
    m_Metadata:
      m_Items:
      - rid: 3853118801594024018
  - m_Id: 1012350803983
    m_Localized: Wird freigeschaltet, wenn die Siedlung Stufe {TierRoman} erreicht.
    m_Metadata:
      m_Items:
      - rid: 3853118801594024018
  - m_Id: 1012350803984
    m_Localized: "Produktionsst\xE4tte {_int_ProducerIndex}"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024018
  - m_Id: 1012350803985
    m_Localized: Die Siedlung wird mit der Zeit nicht mehr verfallen.
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803986
    m_Localized: "Erh\xF6ht die Verm\xF6gensproduktion der Siedlung um {0}."
