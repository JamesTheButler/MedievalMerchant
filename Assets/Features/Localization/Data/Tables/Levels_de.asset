  m_TableData:
  - m_Id: 31624117837824
    m_Localized: Level {_int_LevelIndex:D2}
    m_Metadata:
      m_Items:
      - rid: 1854277275464761472
  - m_Id: 169715130368
    m_Localized: "Neue Anf\xE4nge k\xF6nnen manchmal schwer sein. Nicht in diesem
      Fall. In diesem Level ist alles viel einfacher. Perfekt, um erste Erfahrungen
      zu sammeln!"
    m_Metadata:
      m_Items: []
  - m_Id: 117475074048
    m_Localized: Aller Anfang ist ... leicht
    m_Metadata:
      m_Items: []
  - m_Id: 23031704412160
    m_Localized: "Die Meere sind hier reich an Sch\xE4tzen. Und jeder will seinen
      Teil davon."
    m_Metadata:
      m_Items: []
  - m_Id: 23033407299584
    m_Localized: Lehre einem Mann das Fischen
    m_Metadata:
      m_Items: []
  - m_Id: 23593455935488
    m_Localized: Von Freunden und Feinden
    m_Metadata:
      m_Items: []
  - m_Id: 23694530273280
    m_Localized: "Das Leben eines H\xE4ndlers dreht sich um Beziehungen. W\xE4hle
      deine Verb\xFCndeten mit Bedacht, denn Unterst\xFCtzung und Feindseligkeit
      haben weitreichende Folgen."
    m_Metadata:
      m_Items: []
  - m_Id: 2641516104212480
    m_Localized: "W\xE4hle deine Verb\xFCndeten"
    m_Metadata:
      m_Items: []
  - m_Id: 2641516116795392
    m_Localized: "W\xE4hle eine verb\xFCndete Region und gewinne ihre Gunst.\n\nW\xE4hle
      mit Bedacht, denn dies wird dich einiges an Ansehen in allen anderen Regionen
      kosten."
    m_Metadata:
      m_Items: []
  - m_Id: 23759730728960
    m_Localized: Gangsta's Paradise
    m_Metadata:
      m_Items: []
  - m_Id: 23762297643008
    m_Localized: "Banditen treiben in der Gegend ihr Unwesen und die St\xE4dte liegen
      in Tr\xFCmmern. Zieh besser deine sch\xF6nste R\xFCstung an."
    m_Metadata:
      m_Items: []
  - m_Id: 23805503168512
    m_Localized: Ende schwer, alles schwer
    m_Metadata:
      m_Items: []
  - m_Id: 23857697087488
    m_Localized: "Abschied ist oft schwer. In diesem Fall ist das auch so. Schnall
      dich an und genie\xDFe das letzte Level."
    m_Metadata:
      m_Items: []
  - m_Id: 24112274563072
    m_Localized: "Einf\xFChrung"
    m_Metadata:
      m_Items: []
  - m_Id: 24145132740608
    m_Localized: Willkommen im Spiel! Dieses Level bringt dir die Grundlagen des
      Handels und der Stadtentwicklung bei.
    m_Metadata:
      m_Items: []
  - m_Id: 3281913608364032
    m_Localized: 'Bestzeit: Tag {_int_Day} von Jahr {_int_Year}'
    m_Metadata:
      m_Items:
      - rid: 1854277275464761472
