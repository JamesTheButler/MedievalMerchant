    m_Metadata:
      m_Items: []
  - m_Id: 1012350803975
    m_Localized: "En cas d'\xE9chec"
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803976
    m_Localized: '{0} croissance'
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803977
    m_Localized: "{0} r\xE9putation"
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803978
    m_Localized: "Commande re\xE7ue : {TownName} veut {GoodName}"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803981
    m_Localized: "Vous n'avez pas r\xE9ussi \xE0 livrer suffisamment de {GoodName}.
      {TownName} n'est pas satisfaite."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803982
    m_Localized: "D\xE9croissance de base pour ville de niveau {TierRoman} "
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803983
    m_Localized: "D\xE9bloqu\xE9 quand la ville atteint le niveau {TierRoman}."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803984
    m_Localized: Producteur {_int_ProducerIndex}
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803985
    m_Localized: "La ville ne r\xE9gressera pas avec le temps."
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803986
    m_Localized: Augmente les revenus de la ville de {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803987
    m_Localized: "Am\xE9liore la production de biens de la ville de {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803988
    m_Localized: "Am\xE9liore les prix de la ville de {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803989
    m_Localized: Recevez {0} des revenus des villes.
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803990
    m_Localized: Vous avez construit {ProducerName}.
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803991
    m_Localized: "La ville a \xE9t\xE9 n\xE9glig\xE9e pendant plus de {_int_DayCount}
      jours."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012354998272
    m_Localized: "Vous avez livr\xE9 \xE0 {TownName} les biens dont ils avaient besoin."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012354998273
    m_Localized: "Vous n'avez pas r\xE9ussi \xE0 approvisionner {TownName}."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012354998274
    m_Localized: "Remplir cette mission permettra \xE0 la ville de passer de niveau."
    m_Metadata:
      m_Items: []
  - m_Id: 1012354998275
    m_Localized: 'Production de base pour ville de niveau {TierRoman} '
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
