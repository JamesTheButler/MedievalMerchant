    m_Metadata:
      m_Items: []
  - m_Id: 1012350803969
    m_Localized: Vendez {_int_Amount}x {GoodName}
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803970
    m_Localized: '{_int_CurrentValue}/{_int_MaxValue} vendus'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024017
  - m_Id: 1012350803971
    m_Localized: "En cas de r\xE9ussite"
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803972
    m_Localized: "+{0} pi\xE8ces"
    m_Metadata:
      m_Items: []
