  - m_Id: 5806327224426496
    m_Localized: 'Shown in the trade summary on the player and town side.

      Example:
      "Funds: 5000.1 (-200.2)"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 5807677698039808
    m_Localized: 'Shown in the trade summary on the town side.

