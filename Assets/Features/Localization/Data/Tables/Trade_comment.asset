  - m_Id: 5931804257771520
    m_Localized: 
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 13930291211
    m_Localized: '{0} is a string

      Example: "Availability: Abundant"'
    m_Metadata:
      m_Items: []
  - m_Id: 10492272505217024
    m_Localized: 'Example:

      "This town is growing tired of Berries.

      They
      bought 123 Berries in the last 90 days.

      (-2.5% per 50 goods)"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 10493452765585408
    m_Localized: 'Example:

      "There is a global surplus of 1200 Berries.

      (-1%
      per 50 goods)'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 10495427385188352
    m_Localized: 'Hayville dislikes you! Your reputation: -22.5'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 10495380182491136
    m_Localized: 'Hayville likes you! Your reputation: 22.5'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 11182149794226176
    m_Localized: Found in haggling section in the trade UI in levels 3-5.
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 11231630933843968
    m_Localized: 'Found in haggling section in the trade UI in levels 3-5.

      rep:
      short for reputation; space is very limited for this string'
    m_Metadata:
      m_Items: []
