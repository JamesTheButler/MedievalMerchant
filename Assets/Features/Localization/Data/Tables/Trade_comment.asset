  m_TableData:
  - m_Id: 5801351647420416
    m_Localized: Shown in the haggling UI in the trade panel, below the reputation
      gain/loss in each haggle level.
    m_Metadata:
      m_Items: []
  - m_Id: 13917708288
    m_Localized: 
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 5806327224426496
    m_Localized: 'Shown in the trade summary on the player and town side.

      Example:
      "Funds: 5000.1 (-200.2)"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 5807677698039808
    m_Localized: 'Shown in the trade summary on the town side.

      Example: "Reputation:
      -20.1 (+2.2)"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
  - m_Id: 13930291202
    m_Localized: 
    m_Metadata:
      m_Items:
      - rid: 3853118801594024032
