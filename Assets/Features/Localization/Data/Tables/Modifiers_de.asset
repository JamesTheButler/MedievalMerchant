  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Modifiers_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: adad512837bf8774ab6812d9fd0f6086, type: 2}
  m_Metadata:
    m_Items:
    - rid: 7663118221313572958
  m_TableData:
  - m_Id: 1036262531072
    m_Localized: "Zur\xFCck zu den Wurzeln"
    m_Metadata:
      m_Items: []
  - m_Id: 1036275113984
    m_Localized: "Es ist unter dem Volk zur Mode geworden, ein einfacheres Leben anzustreben."
    m_Metadata:
      m_Items: []
  - m_Id: 1036275113985
    m_Localized: Reiche Gezeiten
    m_Metadata:
      m_Items: []
  - m_Id: 1036275113986
    m_Localized: "Ungew\xF6hnlich ergiebige Str\xF6mungen treiben die Fische n\xE4\
      her ans Ufer."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308288
    m_Localized: Ansteckende Faulheit
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308289
    m_Localized: "Das Leben der Leute wird bequem. Vielleicht etwas zu bequem. Niemand\
      \ will mehr hart arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308290
    m_Localized: Gerissene Snobs
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308291
    m_Localized: "Die reiche Elite wird ungew\xF6hnlich einfallsreich. Wohl ein neuer\
      \ Zeitvertreib."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308292
    m_Localized: Trockene Winde
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308293
    m_Localized: Schlechtes Wetter vernichtet einen Gro\xDFteil der saisonalen Ernte.
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308294
    m_Localized: "Gro\xDFz\xFCgige Adlige"
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308295
    m_Localized: "Der Adel in dieser Gegend ist in Geberlaune und unterst\xFCtzt alle\
      \ St\xE4dte in ihrer Entwicklung."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308296
    m_Localized: Starkregen
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308297
    m_Localized: "Die Wolken sind dunkel, die Luft ist schwer. Dieser Sturm wird so\
      \ schnell nicht enden."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308298
    m_Localized: Pferdemangel
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308299
    m_Localized: Die Leute brauchen Reittiere und nehmen, was sie kriegen.
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308300
    m_Localized: Erdrutsche
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308301
    m_Localized: "Gro\xDFe Teile der Berge sind unpassierbar geworden und die Minen\
      \ kaum noch nutzbar."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308302
    m_Localized: Marktfest
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308303
    m_Localized: "Ein regionales Marktfest lockt H\xE4ndler und Reisende an."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308304
    m_Localized: "Panikkl\xE4ufe"
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308305
    m_Localized: "Ger\xFCchte \xFCber eine nahende Seuche verbreiten sich. Panik greift\
      \ um sich, und die Leute kennen ihre Priorit\xE4ten: alles, womit man sich halbwegs\
      \ den Hintern abwischen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308306
    m_Localized: Goldene Zeiten
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308307
    m_Localized: "Die letzten Jahre liefen hervorragend. Das Volk ist gl\xFCcklich und\
      \ gesund und das Leben ist gut."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308308
    m_Localized: Reiche Ozeane
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308309
    m_Localized: "Die Ozeane sind hier \xFCberaus ergiebig. Leider ist das so ziemlich\
      \ das Einzige im \xDCberfluss. Alles andere ist teuer und schwer zu bekommen.\
      \ Die St\xE4dte sind also ganz wild auf salziges, saftiges Meereszeug!"
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308310
    m_Localized: "Nicht-{RegionName}-St\xE4dte fordern in ihren Missionen nur {RegionName}-Waren\
      \ an."
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308311
    m_Localized: Zeiten des Misstrauens
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308312
    m_Localized: "Die Menschen in dieser Gegend bleiben gern unter sich und misstrauen\
      \ den anderen. Du startest mit den St\xE4dten einer Region auf deiner Seite und\
      \ musst geschickt vorgehen, um es allen recht zu machen."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308313
    m_Localized: "{Percentage} Entwicklungsrate"
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308314
    m_Localized: "{Percentage} Karawanen-Bewegungstempo"
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308315
    m_Localized: '{Percentage} auf Preise {GoodSelector}'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308316
    m_Localized: '{Percentage} auf Einkaufspreise {GoodSelector}'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308317
    m_Localized: '{Percentage} auf Verkaufspreise {GoodSelector}'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308318
    m_Localized: '{Percentage} Produktionsgeschwindigkeit {GoodSelector}'
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308319
    m_Localized: "{Percentage} f\xFCr alle Ansehens\xE4nderungen"
    m_Metadata:
      m_Items:
      - rid: 7663118221313572958
  - m_Id: 1036279308320
    m_Localized: "Deine Verb\xFCndeten starten das Spiel mit einem hohen Ansehen dir\
      \ gegen\xFCber."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308321
    m_Localized: "Diese Stadt ist dein Verb\xFCndeter."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308322
    m_Localized: Diese Stadt ist dein Feind.
    m_Metadata:
      m_Items: []
  - m_Id: 357294081531904
    m_Localized: Laufende Ereignisse
    m_Metadata:
      m_Items: []
  - m_Id: 366830397906944
    m_Localized: 'Ereignis gestartet: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 366897418690560
    m_Localized: 'Ereignis abgelaufen: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1843393402068992
    m_Localized: "Helfende H\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 1843739910299648
    m_Localized: "Willkommen im Spiel! Wir haben es dir zum Einstieg leicht gemacht."
    m_Metadata:
      m_Items: []
  - m_Id: 11241058751963136
    m_Localized: Ereignis
    m_Metadata:
      m_Items: []
  - m_Id: 11241070487625728
    m_Localized: Levelbedingung
    m_Metadata:
      m_Items: []
  - m_Id: 11241954563022848
    m_Localized: Laufende Ereignisse ({0})
    m_Metadata:
      m_Items: []
