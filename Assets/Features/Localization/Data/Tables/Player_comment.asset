  m_TableData:
  - m_Id: 83302014976
    m_Localized: 'Shown in various places before a number, e.g. Upkeep: 5/day.

      (The
      actual upkeep value is not part of this string)'
    m_Metadata:
      m_Items: []
  - m_Id: 363481522176
    m_Localized: Shown in the campsite UI > Companion Tent
    m_Metadata:
      m_Items: []
  - m_Id: 286261699928064
    m_Localized: Shown in any UI where we display the level of a companion.
    m_Metadata:
      m_Items:
      - rid: 1739500523766939800
  - m_Id: 7867967988523008
    m_Localized: 'Example: "12% reduction to costs of production buildings"'
    m_Metadata:
      m_Items: []
  - m_Id: 7868549969174528
    m_Localized: 'Example: "+2.5 reputation when entering town"'
    m_Metadata:
      m_Items: []
  - m_Id: 7868620383150080
    m_Localized: 'Example: "10% bonus for all reputation gains"'
    m_Metadata:
      m_Items: []
  - m_Id: 7876344546287616
    m_Localized: 'Example: "10% shorter travel times"'
    m_Metadata:
      m_Items: []
  - m_Id: 7876385742741504
    m_Localized: 'Example: "10% lower upkeep"'
    m_Metadata:
      m_Items: []
  - m_Id: 7878753846779904
    m_Localized: 'Example: "Thief lvl. 2"'
    m_Metadata:
      m_Items:
      - rid: 1739500523766939800
  - m_Id: 8160697734094848
    m_Localized: Button shown on carts that can be bought.
    m_Metadata:
      m_Items: []
  - m_Id: 8161685496881152
    m_Localized: 'Example: "Level IV"'
    m_Metadata:
      m_Items: []
  - m_Id: 8171731098230784
    m_Localized: Shown in companion UI when hovering a level that isn't unlockable
