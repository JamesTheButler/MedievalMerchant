  m_Name: Levels_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 68c5c92f2f4734246a3940472a960c30, type: 2}
  m_Metadata:
    m_Items:
    - rid: 1854277275464761470
  m_TableData:
  - m_Id: 169715130368
    m_Localized: New beginnings can be hard sometimes. Not in this case. Everything
      is a lot easier in this level. Perfect to get your feet wet!
    m_Metadata:
      m_Items: []
  - m_Id: 117475074048
    m_Localized: Simple Beginnings
    m_Metadata:
      m_Items: []
  - m_Id: 23031704412160
    m_Localized: The oceans are plentiful here. And everybody wants a part of it.
    m_Metadata:
      m_Items: []
  - m_Id: 23033407299584
    m_Localized: Teach a man to fish
    m_Metadata:
      m_Items: []
  - m_Id: 23593455935488
    m_Localized: Of Friends and Foes
    m_Metadata:
      m_Items: []
  - m_Id: 23694530273280
    m_Localized: "A merchant\u2019s life is all about relations. Choose your allies
      carefully, because support and hostility both have lasting consequences."
    m_Metadata:
      m_Items: []
  - m_Id: 23759730728960
    m_Localized: Gangsta's Paradise
    m_Metadata:
      m_Items: []
  - m_Id: 23762297643008
    m_Localized: Crooks are roaming the area and towns are in shambles. You better
      put on your nicest suit of armor.
    m_Metadata:
      m_Items: []
  - m_Id: 23805503168512
    m_Localized: Difficult Ends
    m_Metadata:
      m_Items: []
  - m_Id: 23857697087488
    m_Localized: Endings can be hard sometimes. It's also hard in this case. Buckle
      up and enjoy the final level.
    m_Metadata:
      m_Items: []
  - m_Id: 24112274563072
    m_Localized: Introduction
    m_Metadata:
      m_Items: []
  - m_Id: 24145132740608
    m_Localized: Welcome to the game! This level will teach you the basics of trade
      and town development.
    m_Metadata:
      m_Items: []
  - m_Id: 31624117837824
    m_Localized: Level {_int_LevelIndex:D2}
    m_Metadata:
      m_Items:
      - rid: 1854277275464761470
  - m_Id: 2641516104212480
    m_Localized: Choose your Allies
    m_Metadata:
      m_Items: []
  - m_Id: 2641516116795392
    m_Localized: 'Choose an allied region and gain their favour.

      Pick carefully,
      as this will cose you quite some reputation in all remaining regions.'
    m_Metadata:
      m_Items: []
  - m_Id: 3281913608364032
    m_Localized: 'Best Time: day {_int_Day} of year {_int_Year}'
    m_Metadata:
      m_Items:
      - rid: 1854277275464761470
