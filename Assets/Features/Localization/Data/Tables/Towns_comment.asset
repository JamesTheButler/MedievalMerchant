  m_TableData:
  - m_Id: 363113791578112
    m_Localized: 'Notification title for when an upgrade mission starts.

      Example:
      "Upgrade mission started: Hayville wants berries"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024019
  - m_Id: 1012350803978
    m_Localized: 'Notification title for when a trade mission starts.

      Example":
      "Trade mission started: Hayville wants berries"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024019
  - m_Id: 769364610473984
    m_Localized: Shown when the player hovers a prodcution building in the Town UI
      of a town that they are not in.
    m_Metadata:
      m_Items: []
  - m_Id: 769557762367488
    m_Localized: 'Shown on a production building in the Town UI when a town has access
      to fewer than 3 goods in neighboring regions.

      Can be checked in 2 towns
      in level 1.'
    m_Metadata:
      m_Items: []
  - m_Id: 1012350803984
    m_Localized: 'Shown in town ui above free producer slots.


      Example: "Producer
      1"'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024019
