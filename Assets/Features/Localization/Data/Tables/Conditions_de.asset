  m_TableData:
  - m_Id: 858432430080
    m_Localized: Du verlierst, wenn dir die Taler ausgehen
    m_Metadata:
      m_Items: []
  - m_Id: 858440818688
    m_Localized: "Deine Kassen sind fast leer. Du hast noch {0} Tage, um wieder Taler\
      \ in deinen Beutel zu bekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 858440818689
    m_Localized: "Dir sind die Taler ausgegangen! Du warst mehr als {0} Tage lang\
      \ bankrott."
    m_Metadata:
      m_Items: []
  - m_Id: 858440818690
    m_Localized: 'Noch {0} Tage im Bankrott'
    m_Metadata:
      m_Items: []
  - m_Id: 858440818692
    m_Localized: Du verlierst am Ende von Jahr {0}
    m_Metadata:
      m_Items: []
  - m_Id: 858440818694
    m_Localized: Die Zeit wird knapp! Du hast noch {0} Tage, um zu gewinnen.
    m_Metadata:
      m_Items: []
  - m_Id: 858440818695
    m_Localized: "Die Zeit ist abgelaufen! Du hattest bis zum Ende von Jahr {0},\
      \ um zu gewinnen."
    m_Metadata:
      m_Items: []
  - m_Id: 858440818696
    m_Localized: 'Noch {0} Tage'
    m_Metadata:
      m_Items: []
  - m_Id: 858440818697
    m_Localized: "Entwickle {0} St\xE4dte auf Stufe {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 858440818698
    m_Localized: Sammle {0} Taler an.
    m_Metadata:
      m_Items: []
  - m_Id: 858440818699
    m_Localized: "Halte ein Ansehen von {0} in allen St\xE4dten aufrecht."
    m_Metadata:
      m_Items: []
  - m_Id: 858440818700
    m_Localized: "Erreiche ein Durchschnittsansehen von {0} \xFCber alle St\xE4dte."
