  - m_Id: 518102409221
    m_Localized: 'Message in the onboarding flow.

      {Tier} is a roman numeral'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473027
  - m_Id: 518102409222
    m_Localized: 'Message in the onboarding flow.

      {0} is a number

      {1}
      is the name of a good

      {2} is a town name

      e.g. "Buy 15 hay in
      Hayville"'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473027
  - m_Id: 518106603520
    m_Localized: 'Message in the onboarding flow.

