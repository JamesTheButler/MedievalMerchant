  - m_Id: 518102409216
    m_Localized: 'Tooltip for question mark buttons that open the tutorial menu.

      Example:
      "Tutorial: Caravan"'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473027
  - m_Id: 518102409217
    m_Localized: 'Message in the onboarding flow.

      Example: "Travel to Hayville"'
    m_Metadata:
      m_Items: []
  - m_Id: 518102409218
    m_Localized: 'Message in the onboarding flow.

      Example: "Build berry picker
      in Hayville"'
    m_Metadata:
