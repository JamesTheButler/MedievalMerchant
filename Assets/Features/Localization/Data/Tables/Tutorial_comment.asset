  - m_Id: 518081437696
    m_Localized: Header of the tutorial menu
    m_Metadata:
      m_Items: []
  - m_Id: 518102409216
    m_Localized: 'Tooltip for question mark buttons that open the tutorial menu.

      Example:
      "Tutorial: Caravan"'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473027
  - m_Id: 518102409217
    m_Localized: 'Example: "Travel to Hayville"'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473027
  - m_Id: 518102409218
    m_Localized: 'Example: "Build berry picker in Hayville"'
    m_Metadata:
      m_Items:
      - rid: 1854277321561473027
  - m_Id: 518102409219
    m_Localized: '[Space] is the shortcut key on the keyboard to pause/unpause.'
    m_Metadata:
      m_Items: []
  - m_Id: 518102409220
    m_Localized: '[2] is the shortcut key on the keyboard to set the game speed.'
    m_Metadata:
      m_Items: []
  - m_Id: 518102409221
    m_Localized: 'Example: Upgrade your cart to tier III.'
