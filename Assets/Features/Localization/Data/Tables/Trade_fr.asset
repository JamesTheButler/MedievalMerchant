  m_TableData:
  - m_Id: 13917708288
    m_Localized: "Vous ferez un b\xE9n\xE9fice de {_int_Amount:0.##} pi\xE8ces \xE0
      l'issue de cet \xE9change."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 13930291200
    m_Localized: "Vous ferez une perte de {_int_Amount:0.##} pi\xE8ces \xE0 l'issue
      de cet \xE9change."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 13930291201
    m_Localized: "Vous n'avez pas assez de pi\xE8ces."
    m_Metadata:
      m_Items: []
  - m_Id: 13930291202
    m_Localized: "{TownName} ne poss\xE8de pas les fonds n\xE9cessaires."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 13930291203
    m_Localized: "pi\xE8ces"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291204
    m_Localized: Il n'y a plus d'emplacement pour les biens de niveau {Tier}.
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 10822135158104064
    m_Localized: Prix de base pour biens de niveau {TierRoman}
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 13930291211
    m_Localized: "Disponibilit\xE9 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5931540234723328
    m_Localized: "Voyagez jusqu'\xE0 {TownName} afin d'y commercer."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 13930291224
    m_Localized: Impitoyable
    m_Metadata:
      m_Items: []
  - m_Id: 13930291225
    m_Localized: Ferme
    m_Metadata:
      m_Items: []
  - m_Id: 13930291226
    m_Localized: Juste
    m_Metadata:
      m_Items: []
  - m_Id: 13930291227
    m_Localized: "Cl\xE9ment"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291228
    m_Localized: "G\xE9n\xE9reux"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291229
    m_Localized: "Vous n\xE9gociez impitoyablement"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291230
    m_Localized: "Vous n\xE9gociez fermement"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291231
    m_Localized: "Vous n\xE9gociez justement"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291232
    m_Localized: "Vous n\xE9gociez avec cl\xE9mence"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291233
    m_Localized: "Vous n\xE9gociez g\xE9n\xE9reusement"
    m_Metadata:
      m_Items: []
  - m_Id: 13930291235
    m_Localized: Acheter
    m_Metadata:
      m_Items: []
  - m_Id: 13930291236
    m_Localized: Vendre
    m_Metadata:
      m_Items: []
  - m_Id: 13930291237
    m_Localized: "N\xE9gociation"
    m_Metadata:
      m_Items: []
  - m_Id: 5806327224426496
    m_Localized: 'Fortune : {_int_Current:0.#} ({Change})'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5807677698039808
    m_Localized: "R\xE9putation : {_int_Current:0.#} ({Change})"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5931618450104320
    m_Localized: "{TownName} produit d\xE9j\xE0 {GoodName}. Ils ne veulent pas en
      acheter davantage."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5931804257771520
    m_Localized: '{TownName} ne peut pas acheter {GoodName} car elle n''est pas niveau
      {Tier}.'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 10493452765585408
    m_Localized: "Il y a un exc\xE9dent de {_int_Amount} {GoodName} dans toute la
      r\xE9gion.\n({Percentage} chaque {_int_StepSize} biens)"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 10492272505217024
    m_Localized: "Cette ville se lasse de ce bien : {GoodName}.\nIls ont achet\xE9
      {_int_Amount} {GoodName} au cours des {_int_Days} derniers jours.\n({Percentage}
      pour chaque {_int_StepSize} biens)"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 10495427385188352
    m_Localized: "{TownName} ne vous appr\xE9cie gu\xE8re ! Votre r\xE9putation :
      {_float_Reputation:0.0}"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 10495380182491136
    m_Localized: "{TownName} vous appr\xE9cie ! Votre r\xE9putation : {_float_Reputation:0.0}"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 11182149794226176
    m_Localized: "{Percentage} pi\xE8ces"
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5932190007910400
    m_Localized: '{TownName} : approvisionnement en {GoodName} insuffisant.'
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5932228343848960
    m_Localized: "Vous poss\xE9dez {GoodName} en quantit\xE9 insuffisante."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5932150292045824
    m_Localized: "{TownName} ne poss\xE8de pas {GoodName}. "
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 5932011754184704
    m_Localized: "Vous ne poss\xE9dez pas {GoodName}. "
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 15673468191236096
    m_Localized: "R\xE9serve du campement : {GoodName} en quantit\xE9 insuffisante."
    m_Metadata:
      m_Items:
      - rid: 3853118801594024030
  - m_Id: 10481333840076800
    m_Localized: "Prix \xE0 l'unit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 15675912820350976
    m_Localized: "Il n'y a plus d'espace pour stocker des biens suppl\xE9mentaires."
    m_Metadata:
      m_Items: []
  - m_Id: 15672924626214912
    m_Localized: "Il n'y a plus d'espace dans la r\xE9serve de votre campement."
    m_Metadata:
      m_Items: []
  - m_Id: 15672768715546624
    m_Localized: Il n'y a plus d'espace dans votre inventaire.
    m_Metadata:
      m_Items: []
  - m_Id: 15622948470644736
    m_Localized: "Vous ne poss\xE9dez pas assez de biens."
    m_Metadata:
      m_Items: []
  - m_Id: 11231630933843968
    m_Localized: "{0} r\xE9p"
    m_Metadata:
      m_Items: []
  - m_Id: 3582509017817088
    m_Localized: "Compl\xE9ter la mission"
    m_Metadata:
      m_Items: []
  - m_Id: 3582558938423296
    m_Localized: Max.
    m_Metadata:
      m_Items: []
  - m_Id: 5802583598391296
    m_Localized: "\xC9changer"
    m_Metadata:
      m_Items: []
  - m_Id: 10493472256516096
    m_Localized: "Bien import\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 5931436018851840
    m_Localized: "Voyagez jusqu'\xE0 une ville pour commercer."
    m_Metadata:
      m_Items: []
  - m_Id: 5801351647420416
    m_Localized: Pour 100 biens
    m_Metadata:
      m_Items: []
  - m_Id: 10493489272807424
