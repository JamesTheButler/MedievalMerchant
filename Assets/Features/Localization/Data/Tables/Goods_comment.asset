      m_Items: []
  - m_Id: 10440177513095168
    m_Localized: 'Shown in tooltip when hovering a good while in a town, when the
      town is NOT selling that good.

      Keep short.'
    m_Metadata:
      m_Items: []
  - m_Id: 10593128923750400
    m_Localized: used when a single good is affected
    m_Metadata:
      m_Items:
      - rid: 7663118207318491139
  - m_Id: 10593914831462400
    m_Localized: 'used when goods from any tier in all regions are affected

      Example:
      "Lower prices for all goods from all regions"'
    m_Metadata:
      m_Items: []
  - m_Id: 10594018896338944
    m_Localized: 'used when goods from any tier in specific regions are affected

      Example:
      "Lower prices for all goods from forest and mountains"'
    m_Metadata:
      m_Items:
      - rid: 7663118207318491139
  - m_Id: 10594090392444928
    m_Localized: 'used when goods from a specific tier in all regions are affected

      Example:
      "Lower prices for tier II goods from fall regions"'
    m_Metadata:
      m_Items:
      - rid: 7663118207318491139
  - m_Id: 10594623408791552
    m_Localized: 'used when goods from a specific tier in specific regions are affected

      Example:
      "Lower prices for tier II goods from forest and mountains"'
    m_Metadata:
      m_Items:
      - rid: 7663118207318491139
  - m_Id: 10819178937147392
    m_Localized: 'used when a specific list of goods is affected

      Example:
      "Lower prices for hay, wheat, berries and logs"'
    m_Metadata:
      m_Items:
      - rid: 7663118207318491139
  - m_Id: 10819425184735232
    m_Localized: 'used when all goods are affected

      Example: "Higher production
      rate for all goods"'
    m_Metadata:
      m_Items: []
