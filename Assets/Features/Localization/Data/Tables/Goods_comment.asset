  m_TableData:
  - m_Id: 805684863017
    m_Localized: A good is highly available. Description should be short and tell
      player how to understand the availability.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863016
    m_Localized: Availablity of a good, when there are many goods and prices are
      lower.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863014
    m_Localized: Availablity of a good, when there is a normal amount of goods and
      prices are normal.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863015
    m_Localized: Availablity of a good, when there is a normal amount of goods and
      prices are normal.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863026
    m_Localized: 'Shown in tooltip when hovering prices. Label for the average price
      that the good has been bought for by the player.

      Keep short.'
    m_Metadata:
      m_Items: []
  - m_Id: 805684863025
    m_Localized: 'Shown in tooltip when hovering prices. Label for the default price
      without any applied modifiers.

      Keep short.'
    m_Metadata:
      m_Items: []
  - m_Id: 805684863024
    m_Localized: 'Shown in tooltip when hovering a good while in a town, when the
      town is selling that good.

      Keep short.'
    m_Metadata:
      m_Items: []
  - m_Id: 805684863021
    m_Localized: Name of the ocean region.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863023
    m_Localized: Name of the mountain region.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863020
    m_Localized: Name of the forest region.
    m_Metadata:
      m_Items: []
  - m_Id: 805684863022
    m_Localized: Name of the fields region.
    m_Metadata:
      m_Items: []
