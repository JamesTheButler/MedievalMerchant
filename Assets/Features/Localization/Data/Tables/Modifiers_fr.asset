  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Modifiers_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: adad512837bf8774ab6812d9fd0f6086, type: 2}
  m_Metadata:
    m_Items:
    - rid: 7663118221313572957
  m_TableData:
  - m_Id: 1036262531072
    m_Localized: L'amour des choses simples
    m_Metadata:
      m_Items: []
  - m_Id: 1036275113984
    m_Localized: "Il est d\xE9sormais \xE0 la mode pour le peuple de vivre humblement."
    m_Metadata:
      m_Items: []
  - m_Id: 1036275113985
    m_Localized: "Mar\xE9es g\xE9n\xE9reuses"
    m_Metadata:
      m_Items: []
  - m_Id: 1036275113986
    m_Localized: "Gr\xE2ce \xE0 des courants exceptionnels, un grand nombre de poissons
      se sont rapproch\xE9s des c\xF4tes."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308288
    m_Localized: "\xC9pid\xE9mie de paresse"
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308289
    m_Localized: "Le peuple a la vie facile, peut-\xEAtre un peu trop. Plus personne
      ne souhaite travailler dur."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308290
    m_Localized: Des riches avec des mains en or
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308291
    m_Localized: "Les plus riches se passionnent pour l'artisanat. Ils cherchent
      peut-\xEAtre \xE0 passer le temps."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308292
    m_Localized: Vents secs
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308293
    m_Localized: La plupart des cultures de saison sont victimes du mauvais temps.
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308294
    m_Localized: "Nobles g\xE9n\xE9reux"
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308295
    m_Localized: "Les nobles du coin se sentent d'humeur g\xE9n\xE9reuse, ils participent
      au d\xE9veloppement de toutes les villes."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308296
    m_Localized: Pluies diluviennes
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308297
    m_Localized: "Les nuages sont noirs et l'air est charg\xE9. Cette temp\xEAte
      risque de durer quelque temps."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308298
    m_Localized: "P\xE9nurie de chevaux "
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308299
    m_Localized: "Les petites gens ont besoin de se d\xE9placer, et ils font avec
      ce qu'ils ont."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308300
    m_Localized: Glissement de terrain
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308301
    m_Localized: Une partie des montagnes est inaccessible, rendant les mines difficilement
      praticables.
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308302
    m_Localized: 'Foire paysanne '
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308303
    m_Localized: "Une foire dans la r\xE9gion attire les voyageurs et les marchands
      aux alentours."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308304
    m_Localized: 'Vague de panique '
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308305
    m_Localized: "Le bruit court qu'une \xE9pid\xE9mie est sur le point d'\xE9clater.
      La panique s'installe et le peuple se rue sur les denr\xE9es essentielles,
      c'est-\xE0-dire tout ce qui peut servir \xE0 s'essuyer les fesses."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308306
    m_Localized: "\xC2ge d'or"
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308307
    m_Localized: "Tout va bien depuis quelques ann\xE9es. Le peuple est heureux et
      en bonne sant\xE9, la vie est belle."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308308
    m_Localized: Mers riches
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308309
    m_Localized: "Les oc\xE9ans d'ici regorgent de ressources. Malheureusement, on
      ne peut pas dire la m\xEAme chose des terres. Il est difficile et cher de se
      procurer la plupart des ressources, le peuple r\xE9clame donc des produits
      de l'oc\xE9an en grande quantit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308310
    m_Localized: "Les villes qui ne se situent pas dans la r\xE9gion {RegionName}
      ne demandent que des biens provenant de la r\xE9gion {RegionName} pour leurs
      missions."
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308311
    m_Localized: "Parano\xEFa "
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308312
    m_Localized: "Les gens d'ici pr\xE9f\xE8rent se d\xE9brouiller seuls et ne font
      pas confiance aux autres. Vous commencez avec les villes d'une r\xE9gion de
      votre c\xF4t\xE9, et vous devrez jongler pour garder tout le monde heureux. "
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308313
    m_Localized: "Modificateur de d\xE9veloppement {Percentage}"
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308314
    m_Localized: "Vitesse de d\xE9placement des caravanes {Percentage}"
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308315
    m_Localized: Prix {GoodSelector} {Percentage}
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308316
    m_Localized: Prix d'achat {GoodSelector} {Percentage}
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308317
    m_Localized: Prix de vente {GoodSelector} {Percentage}
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308318
    m_Localized: Vitesse de production {GoodSelector} {Percentage}
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308319
    m_Localized: "Changement de la r\xE9putation {Percentage} "
    m_Metadata:
      m_Items:
      - rid: 7663118221313572957
  - m_Id: 1036279308320
    m_Localized: "Votre r\xE9putation est haute chez vos alli\xE9s d\xE9s le d\xE9but
      de la partie."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308321
    m_Localized: "Cette ville est votre alli\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1036279308322
    m_Localized: Cette ville vous est hostile.
    m_Metadata:
      m_Items: []
  - m_Id: 11241058751963136
    m_Localized: "\xC9v\xE9nement "
    m_Metadata:
      m_Items: []
  - m_Id: 11241070487625728
    m_Localized: Modificateur du niveau
    m_Metadata:
      m_Items: []
  - m_Id: 11241954563022848
    m_Localized: "\xC9v\xE9nements en cours ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1843739910299648
    m_Localized: "Bienvenue sur le jeu ! Nous avons facilit\xE9 les choses pour que
      vous puissiez prendre vos marques."
    m_Metadata:
      m_Items: []
  - m_Id: 1843393402068992
    m_Localized: Coup de main
    m_Metadata:
      m_Items: []
  - m_Id: 366897418690560
    m_Localized: "Fin de l'\xE9v\xE9nement : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 366830397906944
    m_Localized: "D\xE9but de l'\xE9v\xE9nement : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 357294081531904
    m_Localized: "\xC9v\xE9nements en cours "
    m_Metadata:
      m_Items: []
