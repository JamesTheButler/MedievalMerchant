  m_TableData:
  - m_Id: 720119731806208
    m_Localized: Shown in the Esc-menu on the "back to menu" and "quit game" button
      tooltips
    m_Metadata:
      m_Items: []
  - m_Id: 736836516274176
    m_Localized: 'Shown below player icon, when game is paused.

      [Space] is
      the space key and should be translated'
    m_Metadata:
      m_Items: []
  - m_Id: 737370321149952
    m_Localized: Shown when hovering coin icon next to player icon.
