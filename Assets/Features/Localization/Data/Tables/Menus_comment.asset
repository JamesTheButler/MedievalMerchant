    m_Metadata:
      m_Items: []
  - m_Id: 738959656181760
    m_Localized: 'Shown when hovering player icon.

      <size=16> must be kept
      in the translation. It changes the size of the text.'
    m_Metadata:
      m_Items: []
  - m_Id: 739029873025024
    m_Localized: Shown when hovering player icon.
    m_Metadata:
      m_Items: []
  - m_Id: 740719653249024
    m_Localized: Shown when hovering the date in the top right.
    m_Metadata:
      m_Items: []
  - m_Id: 772091394613248
    m_Localized: Shown in Retinue panel
    m_Metadata:
      m_Items: []
  - m_Id: 1064582471681
    m_Localized: 'Shown after winning a level.

      Leave the <style> tag intact,
      it colors part of the text.

      Example: "Congratulations! You successfully
      completed Level 02: Teach a man to fish"'
    m_Metadata:
      m_Items:
      - rid: 1739500596695924826
  - m_Id: 1064582471682
    m_Localized: 'Shown after losing a level.

      Example: You failed to complete
      Level 02: Teach a man to fish'
    m_Metadata:
      m_Items:
      - rid: 1739500596695924826
  - m_Id: 1064582471683
    m_Localized: 'Shown in the end-of-game stats in the "favorite good" line.

      Example:
      Berries (traded 2300 times)'
    m_Metadata:
      m_Items:
      - rid: 1739500596695924826
