  m_Script: {fileID: 11500000, guid: 78c39ca0aa3b4c60ad7cb11e9f4cf262, type: 3}
  m_Name: TutorialTopic_Controls
  m_EditorClassIdentifier: Assembly-CSharp::Features.Tutorial.Data.TutorialTopicData
  <Title>k__BackingField: Controls & the World Map
  <Chapters>k__BackingField:
  - <Title>k__BackingField: Camera Movement
    <Description>k__BackingField: Move the camera with WASD. Hold the middle mouse
      button to pan the view. Pressing Space bar centers the camera on your location.
    <Image>k__BackingField: {fileID: 2800000, guid: b1138daac9736844bae874a9b26c3b9f, type: 3}
  - <Title>k__BackingField: Traveling to Towns
    <Description>k__BackingField: Right-click on a town to move your caravan there.
      Travel takes time and costs upkeep.
    <Image>k__BackingField: {fileID: 2800000, guid: 7cbb18101c3f2ef418b9e1b357ef6207, type: 3}
  - <Title>k__BackingField: Town Details
    <Description>k__BackingField: ' Left-click towns and production zones to inspect
      their details.'
    <Image>k__BackingField: {fileID: 2800000, guid: 92caeb479478f8e4084ba4643df1cfd2, type: 3}
