  m_Script: {fileID: 11500000, guid: 78c39ca0aa3b4c60ad7cb11e9f4cf262, type: 3}
  m_Name: TutorialTopic_Production
  m_EditorClassIdentifier: Assembly-CSharp::Features.Tutorial.Data.TutorialTopicData
  <Title>k__BackingField: Town Production
  <Chapters>k__BackingField:
  - <Title>k__BackingField: Production Buildings
    <Description>k__BackingField: 'You can finance production buildings in towns
      to make them produce goods and raise development.

      Constructing producers
      is essential as they add more resources to your trade network and enable you
      to complete missions, react to world events and make profits by supplying the
      right goods at the right time.'
    <Image>k__BackingField: {fileID: 2800000, guid: c383bf2cacf907545a33bd17c325868f, type: 3}
  - <Title>k__BackingField: Production Tiers
    <Description>k__BackingField: 'Tier I buildings can be built based on the towns
      neighboring regions.

      Tier II buildings are built on top of Tier I buildings.

      Tier
      III buildings are built on top of a Tier II producer and require a seconds
      Tier II good to produce Tier III goods. This second good can either be produced
      in the town or must be delivered (sold) by you.'
    <Image>k__BackingField: {fileID: 2800000, guid: c0a77cebe55681e418b4dd17db294ec3, type: 3}
