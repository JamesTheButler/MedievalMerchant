  m_Script: {fileID: 11500000, guid: 78c39ca0aa3b4c60ad7cb11e9f4cf262, type: 3}
  m_Name: TutorialTopic_Production
  m_EditorClassIdentifier: Assembly-CSharp::Features.Tutorial.Data.TutorialTopicData
  <Title>k__BackingField: Town Production
  <Chapters>k__BackingField:
  - <Title>k__BackingField: Production Zones
    <Description>k__BackingField: Towns have goods from nearby production zones such
      as forests, fields, or the ocean. To produce them, you must finance production
      buildings
    <Image>k__BackingField: {fileID: 2800000, guid: 489cf1137e4ac184c915a339106a22e4, type: 3}
  - <Title>k__BackingField: Production Buildings
    <Description>k__BackingField: You can build additional production buildings to
      increase output and unlock new goods. This will also raise the development
      of the town.
    <Image>k__BackingField: {fileID: 2800000, guid: 489cf1137e4ac184c915a339106a22e4, type: 3}
  - <Title>k__BackingField: Production Tiers
    <Description>k__BackingField: 'Tier II buildings are built on top of Tier I buildings.

      Tier
      III buildings require two Tier II goods to operate, and at least one of those
      goods must be produced locally.'
    <Image>k__BackingField: {fileID: 2800000, guid: 489cf1137e4ac184c915a339106a22e4, type: 3}
